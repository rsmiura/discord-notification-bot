# Required for the Discord connection.
DISCORD_TOKEN=your_discord_bot_token_here

# All three are needed for automatic livestream alerts.
YOUTUBE_API_KEY=your_youtube_data_api_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here
TWITCH_STREAM_URL=https://www.twitch.tv/your_twitch_channel

# Optional. Relative to this project; omit to keep existing JSON files here.
# Docker sets this to /data for its persistent volume.
# DATA_DIR=.
